[Unit]
Description=Gemini Brain AST & Markdown Sync Daemon (Raspberry Pi 5)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=simon
WorkingDirectory=/opt/gemini-brain/rpi-sync
EnvironmentFile=/etc/gemini-brain/watcher.env
ExecStart=/opt/gemini-brain/rpi-sync/.venv/bin/python /opt/gemini-brain/rpi-sync/brain_watcher.py
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
